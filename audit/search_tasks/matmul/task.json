{
  "name": "search-pilot-matmul",
  "objective": "Equal-weight total eager wall latency; FP32 input/output, no input mutation. This is a public development workload, not held-out final acceptance.",
  "device": "cuda:0",
  "timer": "wall",
  "rtol": 0.0001,
  "atol": 0.0002,
  "min_gain": 0.02,
  "max_regression": 0.05,
  "max_baseline_regression": 0.05,
  "cases": [
    {
      "id": "rectangular",
      "args": {
        "device": "cuda:0",
        "m": 64,
        "n": 96,
        "k": 128,
        "stride": 1
      },
      "weight": 1,
      "quick": true
    },
    {
      "id": "square",
      "args": {
        "device": "cuda:0",
        "m": 256,
        "n": 256,
        "k": 256,
        "stride": 1
      },
      "weight": 1,
      "quick": false
    },
    {
      "id": "strided-tail",
      "args": {
        "device": "cuda:0",
        "m": 127,
        "n": 257,
        "k": 63,
        "stride": 2
      },
      "weight": 1,
      "quick": false
    }
  ]
}
